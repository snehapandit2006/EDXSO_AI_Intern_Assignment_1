# EDXSO Environment Configuration Template
# Copy this file to '.env' and fill in your local API keys and SMTP credentials.

# Gemini AI API Key (Optional: for live LLM personalization generation)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Access Token (Optional: increases public rate limits for Source A discovery)
GITHUB_TOKEN=your_github_token_here

# Outreach Sending Layer Configuration
# Supported modes: 'simulation' (default, offline mock) or 'smtp' (live email sending)
SEND_MODE=simulation

# SMTP Email Server Configuration (Required only if SEND_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_app_password_here
SMTP_FROM_EMAIL=your_email@domain.com
